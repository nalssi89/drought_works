# Server-side KMA APIHub key. Never expose or commit the real value.
KMA_API_AUTH_KEY=

# Secret required by the scheduled Edge Function POST. Use at least 32 characters.
CRON_SECRET=

# Supabase Edge Function used by the scheduled-cache path.
KMA_CACHE_URL=
KMA_PROXY_ANON_KEY=

# Optional server-side proxy for historical official lookups.
KMA_PROXY_URL=

# Comma-separated allowed origins for metadata generation.
PUBLIC_SITE_ORIGIN=https://kma-regional-precip.solverrrrr.chatgpt.site
SITE_ORIGIN_ALLOWLIST=http://localhost:3000,https://kma-regional-precip.solverrrrr.chatgpt.site
